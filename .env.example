# ----------------------------------------
# ---- Application ----
# ----------------------------------------
APP_NAME=inbox
APP_ENV=prod
APP_VERSION=1.0.0
SERVER_PORT=8080

# ----------------------------------------
# ---- MongoDB Atlas ----
# ----------------------------------------
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/inbox?retryWrites=true&w=majority

# ----------------------------------------
# ---- JWT ----
# ----------------------------------------
JWT_SECRET=<jwt_secret>
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ----------------------------------------
# ---- Upstash Redis ----
# ----------------------------------------
UPSTASH_REDIS_URL=rediss://default:<pass>@<host>.upstash.io:6379

# ----------------------------------------
# ---- Cloudinary ----
# ----------------------------------------
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# ----------------------------------------
# ---- CORS ----
# ----------------------------------------
CORS_ALLOWED_ORIGINS=https://inbox.vercel.app

# ----------------------------------------
# ---- Frontend (Vite) ----
# ----------------------------------------
VITE_API_BASE_URL=https://inbox-backend.onrender.com
VITE_WS_BASE_URL=wss://inbox-backend.onrender.com
