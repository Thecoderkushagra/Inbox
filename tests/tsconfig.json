{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../frontend/src/*"],
      "@tests/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"]
}
